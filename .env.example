# LLM（至少配置一个；当前实现优先使用 DeepSeek）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner
# 模型管理持久化。留空时使用 .data/models.sqlite，并自动生成本机加密密钥。
MODEL_DB_PATH=
MODEL_ENCRYPTION_KEY=

# MySQL 目标库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# SSH 隧道；不使用 SSH 时设置 SSH_ENABLED=false
SSH_ENABLED=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PRIVATE_KEY_PATH=
SSH_PRIVATE_KEY_PASSPHRASE=

# 本地开发固定端口；API_PORT 可在部署时覆盖。
API_PORT=3001
# 可配置逗号分隔的正式 Web Origin；未配置时仍允许 http(s)://<当前主机>:3000。
WEB_ORIGIN=http://localhost:3000
# 本地/局域网访问通常留空，浏览器会使用 http://<当前页面 hostname>:3001。
# Nginx + HTTPS 部署时可设置为正式 API 域名，例如 https://api.example.com。
NEXT_PUBLIC_API_BASE_URL=
QUERY_MAX_ROWS=200

# 外部系统调用 /api/v1/* 时，请在“个人中心 → API Key”创建 dp_ 前缀的 Key。
# Key 明文仅创建时返回，服务端只保存 SHA-256 hash；不要在 .env 或代码中提交真实 Key。
# 每个 API Key 调用 /api/v1/query 的每分钟上限。
API_KEY_QUERY_RATE_LIMIT_PER_MINUTE=60

# 多轮分析会话持久化与送入模型的最近问答轮数；路径为空时使用 .data/sessions.sqlite。
SESSION_DB_PATH=
SESSION_CONTEXT_TURNS=10

# 知识库与向量检索。生产默认使用 Milvus；local 仅允许开发和测试。
KNOWLEDGE_DB_PATH=
VECTOR_STORE_PROVIDER=milvus
LOCAL_VECTOR_DB_PATH=
# Milvus 连接配置：
MILVUS_ADDRESS=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=datapilot_knowledge_chunks

# 首位注册用户继承本地演示租户/账套，确保现有数据源与 Mapping 仍可访问。
DEFAULT_TENANT_ID=demo-tenant
DEFAULT_ACCOUNT_SET_ID=default-account-set

# 可选：用于加密持久化的数据库连接配置。不设置时会在本机 .data 目录自动生成密钥。
CONNECTION_ENCRYPTION_KEY=
