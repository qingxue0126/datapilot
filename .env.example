# LLM（至少配置一个；当前实现优先使用 DeepSeek）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MySQL 目标库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# SSH 隧道；不使用 SSH 时设置 SSH_ENABLED=false
SSH_ENABLED=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PRIVATE_KEY_PATH=
SSH_PRIVATE_KEY_PASSPHRASE=

# 本地 API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
QUERY_MAX_ROWS=200

# 首位注册用户继承本地演示租户/账套，确保现有数据源与 Mapping 仍可访问。
DEFAULT_TENANT_ID=demo-tenant
DEFAULT_ACCOUNT_SET_ID=default-account-set

# 可选：用于加密持久化的数据库连接配置。不设置时会在本机 .data 目录自动生成密钥。
CONNECTION_ENCRYPTION_KEY=
